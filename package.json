{
  "name": "holiday-guild-auth",
  "version": "1.0.0",
  "description": "Sistema de autenticação e perfil para HOLIDAY Guild",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "setup-ssl": "node generate-cert.js",
    "https": "npm run setup-ssl && node server-https.js",
    "https-dev": "npm run setup-ssl && nodemon server-https.js",
    "frontend": "node frontend-server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "google-auth-library": "^11.3.4",
    "http-proxy-middleware": "^3.0.7",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.5.0",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.5.0",
    "pem": "^1.14.8",
    "selfsigned": "^5.5.0",
    "sqlite3": "^6.0.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "wrangler": "^4.65.0"
  },
  "keywords": [],
